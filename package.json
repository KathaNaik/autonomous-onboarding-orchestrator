{
  "name": "autonomous-onboarding-orchestrator",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @aoo/shared build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm typecheck && pnpm test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "pnpm --filter @aoo/db db:generate",
    "db:migrate": "pnpm --filter @aoo/db db:migrate",
    "hris:simulate": "pnpm --silent --filter @aoo/hris-simulator start",
    "worker:admin": "pnpm --silent --filter @aoo/worker admin",
    "servicenow:check": "pnpm --silent --filter @aoo/servicenow check",
    "servicenow:fulfillment:check": "pnpm --silent --filter @aoo/servicenow fulfillment:check",
    "servicenow:export:check": "pnpm --silent --filter @aoo/servicenow export:check",
    "servicenow:fulfillment:acl-check": "pnpm --silent --filter @aoo/servicenow fulfillment:acl-check",
    "test:servicenow:live": "vitest run --config packages/servicenow/vitest.live.config.ts && vitest run --config packages/orchestrator/vitest.live.config.ts",
    "test:servicenow:approval:live": "vitest run --config apps/api/vitest.live.config.ts apps/api/test/live/approval-callback.live.test.ts",
    "agent:eval:live": "pnpm --silent --filter @aoo/agents eval:live",
    "test:m6b:live": "vitest run --config packages/orchestrator/vitest.live.config.ts packages/orchestrator/test/live/authorization.live.test.ts",
    "okta:check": "pnpm --silent --filter @aoo/okta check",
    "test:okta:live": "vitest run --config packages/orchestrator/vitest.live.config.ts packages/orchestrator/test/live/okta-provisioning.live.test.ts",
    "github:check": "pnpm --silent --filter @aoo/github check",
    "test:github:live": "vitest run --config apps/api/vitest.live.config.ts apps/api/test/live/github-provisioning.live.test.ts",
    "test:servicenow:fulfillment:live": "vitest run --config apps/api/vitest.live.config.ts apps/api/test/live/servicenow-fulfillment.live.test.ts",
    "test:provisioning:live": "vitest run --config apps/api/vitest.live.config.ts apps/api/test/live/provisioning.live.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
