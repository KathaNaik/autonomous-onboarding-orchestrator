{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && npx -y pnpm@12.5.1 install --frozen-lockfile",
  "buildCommand": "cd ../.. && npx -y pnpm@12.5.1 --filter @aoo/api... build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": { "maxDuration": 60 }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
