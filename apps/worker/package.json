{
  "name": "@aoo/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --conditions=source src/main.ts",
    "start": "node dist/main.js",
    "admin": "tsx --conditions=source src/admin.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "qstash:schedule": "tsx --conditions=source src/bin/qstash-schedule.ts"
  },
  "dependencies": {
    "@aoo/agents": "workspace:*",
    "@aoo/catalog": "workspace:*",
    "@aoo/db": "workspace:*",
    "@aoo/github": "workspace:*",
    "@aoo/okta": "workspace:*",
    "@aoo/orchestrator": "workspace:*",
    "@aoo/policy": "workspace:*",
    "@aoo/servicenow": "workspace:*",
    "@aoo/telemetry": "workspace:*",
    "@upstash/qstash": "^2.12.0",
    "drizzle-orm": "^0.45.3",
    "pino": "^10.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@aoo/shared": "workspace:*",
    "tsx": "^4.23.15"
  }
}
