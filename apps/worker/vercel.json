{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd ../.. && npx -y pnpm@12.5.1 install --frozen-lockfile",
  "buildCommand": "cd ../.. && npx -y pnpm@12.5.1 --filter @aoo/worker... build",
  "outputDirectory": "public",
  "functions": {
    "api/worker/run.js": { "maxDuration": 300 },
    "api/health.js": { "maxDuration": 10 }
  }
}
