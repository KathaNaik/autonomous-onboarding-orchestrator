# apps/api
API_PORT=4000
API_HOST=0.0.0.0
LOG_LEVEL=info
# HMAC-SHA256 secret shared with the HRIS (>= 32 chars). Development-only value below.
HRIS_WEBHOOK_SECRET=dev-only-hris-webhook-secret-change-me
HRIS_WEBHOOK_BODY_LIMIT_BYTES=65536

# apps/web
WEB_PORT=3000
API_BASE_URL=http://localhost:4000

# PostgreSQL (docker compose; development-only credentials)
POSTGRES_USER=aoo
POSTGRES_PASSWORD=aoo
POSTGRES_DB=aoo
POSTGRES_PORT=5432

# @aoo/db: used by `pnpm db:migrate` and the WorkflowService
DATABASE_URL=postgres://aoo:aoo@localhost:5432/aoo

# Integration tests: admin connection used to create a throwaway database per run
TEST_DATABASE_URL=postgres://aoo:aoo@localhost:5432/aoo

# apps/hris-simulator (also reads HRIS_WEBHOOK_SECRET)
HRIS_WEBHOOK_URL=http://localhost:4000/webhooks/hris

# apps/worker (outbox consumer)
# WORKER_ID defaults to <hostname>-<pid>; set it only to pin a stable name.
# WORKER_ID=worker-1
WORKER_HEALTH_HOST=0.0.0.0
# Health endpoints: GET /live, GET /ready
WORKER_HEALTH_PORT=4100
WORKER_SHUTDOWN_TIMEOUT_MS=15000
OUTBOX_BATCH_SIZE=10
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_LEASE_MS=30000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_BACKOFF_BASE_MS=1000
OUTBOX_BACKOFF_MAX_MS=300000

# ServiceNow PDI (M4A: read-only). Setup: packages/servicenow/servicenow-app/SETUP.md
# Put real values ONLY in the git-ignored .env. Never put real values in this file.
# Always single-quote passwords: an unquoted `#` starts a comment (silently truncating the
# value) and Docker Compose expands `$`.
SERVICENOW_INSTANCE_URL=https://dev000000.service-now.com
SERVICENOW_USERNAME=aoo.integration
SERVICENOW_PASSWORD=''
SERVICENOW_ACCESS_REQUEST_TABLE=x_0000000_autonomo_onboarding_access_request
SERVICENOW_TIMEOUT_MS=10000
SERVICENOW_MAX_RETRIES=2
SERVICENOW_RETRY_BASE_MS=250
# Optional, schema verification only (pnpm servicenow:check --schema, live test); never used at runtime:
# SERVICENOW_SCHEMA_USERNAME=aoo.schema.verifier
# SERVICENOW_SCHEMA_PASSWORD=''

# Worker: durable external operations (M4B)
EXTERNAL_OP_RECONCILE_ATTEMPTS=3
EXTERNAL_OP_RECONCILE_DELAY_MS=1000
# Compose passes this to the worker as SERVICENOW_TIMEOUT_MS (3 × timeout ≤ 0.8 × OUTBOX_LEASE_MS).
WORKER_SERVICENOW_TIMEOUT_MS=5000

# ServiceNow approval callbacks (M4C, API). Dedicated secret: not the HRIS secret, not a password.
# Must equal the PRIVATE GLOBAL ServiceNow property aoo.approval_callback.secret (never an app-scope property).
SERVICENOW_CALLBACK_SECRET=''
SERVICENOW_CALLBACK_INSTANCE=dev000000
SERVICENOW_CALLBACK_TABLE=x_0000000_autonomo_onboarding_access_request
SERVICENOW_CALLBACK_MAX_SKEW_MS=300000
# Live approval test: local port exposed through a temporary public tunnel.
APPROVAL_LIVE_PORT=4810

# Role Access Agent (M6A): recommendation-only model calls through the OpenAI Responses API
# (Structured Outputs). Used by the explicit live evaluation (pnpm agent:eval:live) and, later,
# by orchestration. Never commit a real key.
OPENAI_API_KEY=''
OPENAI_MODEL=gpt-5.6-sol
# OPENAI_BASE_URL=https://api.openai.com
ROLE_ACCESS_AGENT_TIMEOUT_MS=60000
ROLE_ACCESS_AGENT_MAX_ATTEMPTS=3
ROLE_ACCESS_AGENT_MAX_TOKENS=8192

# Okta provisioning (M7A). API-token (SSWS) auth for the sandbox; production should use a scoped
# OAuth service app. Real values only in the git-ignored .env. Group ids are org-specific targets
# (never in the released catalog); NAME must equal the group's exact Okta name.
OKTA_BASE_URL=''
OKTA_API_TOKEN=''
OKTA_ENGINEERING_GROUP_ID=''
OKTA_ENGINEERING_GROUP_NAME=''
# Optional second target (catalog resource jira-engineering):
OKTA_JIRA_ENGINEERING_GROUP_ID=''
OKTA_JIRA_ENGINEERING_GROUP_NAME=''
OKTA_TIMEOUT_MS=10000
OKTA_MAX_RETRIES=2
OKTA_RETRY_BASE_MS=250

# GitHub provisioning (M7B). Personal-access-token auth for the dedicated test org (fine-grained,
# org "Members: read/write" + "Administration: read"); production should use a GitHub App
# installation token. Real values only in the git-ignored .env. Team NAME must equal the team's
# exact GitHub name. Employee GitHub usernames are never configured here: HR records them through
# the operator page/API. GITHUB_TEST_USERNAME is test-fixture input for pnpm github:check
# and the live test only: a controlled account already an active org member, not yet on the team.
GITHUB_TOKEN=''
GITHUB_ORG=''
GITHUB_TEST_USERNAME=''
GITHUB_BACKEND_TEAM_SLUG=''
GITHUB_BACKEND_TEAM_NAME=''
GITHUB_FRONTEND_TEAM_SLUG=''
GITHUB_FRONTEND_TEAM_NAME=''
# GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT_MS=10000
GITHUB_MAX_RETRIES=2
GITHUB_RETRY_BASE_MS=250

# HR/onboarding operator routes (M7B): record an employee's GitHub username. Shared bearer token
# for operators (dedicated: not the HRIS or callback secret); unset disables the routes. Compose
# uses a development-only default. Never commit a real value.
ONBOARDING_ADMIN_TOKEN=''

# Provisioning orchestration (M7C, worker). The worker drives provisioning automatically; Okta and
# GitHub are used only when their tokens above are set (otherwise resources are blocked visibly).
PROVISIONING_SWEEP_INTERVAL_MS=60000
PROVISIONING_RECONCILE_INTERVAL_MS=300000
PROVISIONING_RETRY_DELAY_MS=60000

# ServiceNow fulfillment (M7D). The worker creates fulfillment records only when enabled.
PROVISIONING_SERVICENOW_FULFILLMENT_ENABLED=false
PROVISIONING_FULFILLMENT_RECONCILE_INTERVAL_MS=120000
# Synthetic human fulfiller (holds only the fulfillment_agent role). Used ONLY by
# pnpm servicenow:fulfillment:check (user name) and pnpm test:servicenow:fulfillment:live.
# Single-quote the password. Never commit real values.
SERVICENOW_FULFILLER_USERNAME=''
SERVICENOW_FULFILLER_PASSWORD=''
